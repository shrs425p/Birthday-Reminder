# Required: JWT signing secret for auth tokens
JWT_SECRET="replace-with-a-long-random-secret"

# Required: Backend server port
PORT="3000"

# Required: Encryption material for DB-stored secrets
DB_ENCRYPTION_KEY="replace-with-a-long-random-secret"
DB_ENCRYPTION_SALT="replace-with-a-unique-random-salt"

# Required: SMTP transport settings for scheduler mail sending
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"

# Required: App URL used in email CTA links
FRONTEND_URL="https://your-app-domain.example"

# Required: Cron schedule for auto-send job
CRON_SCHEDULE="0 8 * * *"

# Optional: Bootstrap admin credentials for first run
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-strong-admin-password"
